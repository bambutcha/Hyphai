{
  "name": "hyphai",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "bun run --filter @hyphai/api dev",
    "dev:web": "bun run --filter @hyphai/web dev",
    "db:migrate": "bun run --filter @hyphai/api db:migrate",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "author": "Daniel Yagolnik",
  "license": "MIT"
}
